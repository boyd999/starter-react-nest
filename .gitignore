# Dependencies
node_modules/

# Yarn 4 (node-modules linker) — keep the pinned release, ignore the rest
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp.*

# Build output
dist/
build/
*.tsbuildinfo

# Turborepo
.turbo/

# Environment — .env.example is the committed template
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# The Claude Code skills, settings and format hook are part of the template and
# must ship with it. A personal ~/.gitignore_global containing `.claude/` would
# otherwise exclude them silently — repo .gitignore takes precedence over the
# global one. Personal permission state stays local.
!.claude/
.claude/settings.local.json

# Editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Test output
coverage/
